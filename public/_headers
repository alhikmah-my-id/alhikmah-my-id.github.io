# ALHIKMAH — Cloudflare Pages header rules
# Format: [url] then indented [name]: [value]

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://cdn.ampproject.org https://alhikmah.disqus.com https://*.disqus.com https://*.disquscdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://alhikmah.my.id https://*.disqus.com https://pagead2.googlesyndication.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://disqus.com https://*.disqus.com; object-src 'none'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/static/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.js
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/*.css
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Ad network verification files — never cache, must be fresh
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/app-ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/iklan.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=600
  Access-Control-Allow-Origin: *

# Security-sensitive paths
/pages/privacy
  X-Robots-Tag: index, follow

/pages/terms
  X-Robots-Tag: index, follow

# Preview / staging domain — keep out of search index
https://al-hikmah.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# API responses
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Cache-Control: no-store